# ThermoGuard ML Microservice Configuration

# Server Settings
APP_NAME=ThermoGuard ML Service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security & Model Paths
# Models are strictly loaded from this directory; client-provided paths are rejected
MODEL_DIR=models
MODEL_FILENAME=xgb_heatwave.json

# Request Protection
REQUEST_TIMEOUT_SECONDS=5.0
MAX_CONTENT_LENGTH=1048576

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:5173
