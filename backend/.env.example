# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/thermoguard
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/thermoguard?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/thermoguard

# JWT Secrets & Expiration
JWT_SECRET=thermoguard_jwt_super_secure_production_secret_key_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# External Meteorological Service Configuration
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
METEO_TIMEOUT_MS=5000

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Python FastAPI Machine Learning Microservice
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=3000
