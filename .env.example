# ================================================================
# ThermoGuard Frontend Environment Configuration
# ================================================================

# Note: The system runs 100% free with Open-Meteo High-Resolution 0.1 deg Grid
# without requiring any API key.

# ThermoGuard Backend API Base URL
# Local development default: http://localhost:5000/api
# Production deployment: https://your-backend-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: Free OpenWeatherMap API Key (Format: owm_your_api_key)
# VITE_OPENWEATHER_API_KEY=

# Optional: Free WeatherAPI Key
# VITE_WEATHERAPI_KEY=


